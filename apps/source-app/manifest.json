{
  "_metadata": {
    "major_version": 2
  },
  "display_information": {
    "name": "Migration Exporter",
    "description": "Read-only export of users, channels and messages for a workspace migration."
  },
  "features": {
    "bot_user": {
      "display_name": "Migration Exporter",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "users:read",
        "users:read.email",
        "channels:read",
        "channels:history",
        "channels:join",
        "groups:read",
        "groups:history",
        "files:read",
        "reactions:read",
        "pins:read"
      ],
      "user": [
        "users:read",
        "users:read.email",
        "channels:read",
        "channels:history",
        "groups:read",
        "groups:history",
        "files:read",
        "reactions:read",
        "pins:read"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": true,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}