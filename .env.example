# ---- Source workspace (Migration Exporter app) ----
# xoxb- bot token, or an admin's xoxp- user token to also export private channels they're in
SOURCE_TOKEN=xoxb-...
# Optional, to migrate DMs: the same app's Client ID / Secret. Adds a "step 1: old workspace"
# button to the serve-oauth page. The redirect URL defaults to TARGET_REDIRECT_URI.
# SOURCE_CLIENT_ID=
# SOURCE_CLIENT_SECRET=
# SOURCE_REDIRECT_URI=https://YOUR-TUNNEL.example.com/slack/oauth/callback

# ---- Target workspace (Migration Importer app) ----
TARGET_CLIENT_ID=
TARGET_CLIENT_SECRET=
TARGET_REDIRECT_URI=https://YOUR-TUNNEL.example.com/slack/oauth/callback
# Optional: otherwise taken from the first OAuth install
# TARGET_BOT_TOKEN=xoxb-...

# Where the export and import state live (contains tokens and private messages!)
MIGRATION_DATA_DIR=migration_data
OAUTH_PORT=3000

# ---- Enterprise Grid only (org-ready apps get org-level tokens) ----
# SOURCE_TEAM_ID=T...   workspace to export
# TARGET_TEAM_ID=T...   workspace to import into
